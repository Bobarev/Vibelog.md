{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "allowJs": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.mjs",
    "dist",
    "node_modules"
  ]
}
