{
  "default_agent": "vb",
  "max_wall_time": 2400,
  "max_requests": 80,
  "branch_mode": true,
  "task_type_styles": {
    "bug": "danger",
    "feature": "success",
    "enhancement": "primary",
    "epic": "primary"
  },
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath=/Applications/Yandex.app/Contents/MacOS/Yandex",
        "--isolated",
        "--headless=false",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "trust": true,
      "timeoutMs": 120000
    }
  },
  "code_same_session": true,
  "workflows": {
    "investigation": {
      "initial_status": "To Do",
      "transitions": [
        {
          "status": "To Do",
          "phase": "investigate",
          "produces_status": "Review"
        },
        {
          "status": "Review",
          "phase": "materialize",
          "produces_status": "Done"
        },
        {
          "status": "Review",
          "phase": "reject",
          "produces_status": "Done"
        },
        {
          "status": "Done",
          "phase": null,
          "produces_status": null
        }
      ]
    }
  },
  "task_workflows": {
    "investigation": "investigation"
  },
  "phase_labels": {
    "investigate": "Расследование",
    "materialize": "Создать задачи"
  },
  "phase_emojis": {
    "investigate": "🔍",
    "materialize": "📦"
  },
  "gateways": {
    "routerai": {
      "base_url": "https://routerai.ru/api/v1",
      "api_key_env": "ROUTERAI_API_KEY"
    },
    "selectel": {
      "base_url": "https://api.selectel.ru/aig/v1",
      "api_key_env": "SELECTEL_API_KEY"
    }
  },
