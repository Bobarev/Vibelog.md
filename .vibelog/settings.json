  "compact": true,
  "chat_personas": {
    "researcher": {
      "label": "Ресёрчер",
      "description": "Ищет информацию и предлагает задачи",
      "prompt": "researcher",
      "default_status": "Spec"
    },
    "auditor": {
      "label": "Аудитор",
      "prompt": "auditor",
      "description": "Находит несоответствия, создаёт задачи на фикс",
      "default_status": "Spec",
      "allow_tools": [
        "backlog_search",
        "read_file",
        "search_files",
        "backlog_create_task",
        "backlog_update_task",
        "ask_user",
        "ask_persona",
        "memory_remember",
        "edit",
        "backlog_add_comment",
        "document_list",
        "document_view",
        "document_update",
        "document_edit",
        "document_search",
        "document_create"
      ]
    },
    "architect": {
      "label": "Архитектор",
      "prompt": "architect",
      "description": "Исследует код и backlog глубже, создаёт задачи в Planned",
      "default_status": "Planned"
    }
  },
  "commit_coauthor": true,
  "pricing_guard": {
    "enabled": true,
    "on_drift": "ask",
    "catalog_ttl_minutes": 5,
    "offline": "allow"
  },
  "upstream": {
    "mode": "git",
    "inbox": "git@gitverse.ru:Vibelog-md/upstream-reports.git",
    "prefix": "vl",
    "repo": "bobarev/Vibelog.md",
    "labels": [
      "upstream",
      "from-vl"
    ],
    "type": "bug"
  },
  "components": {
    "schemaVersion": 1,
    "registries": {
      "vibelog.md": {
        "owner": "Vibelog-md",
        "branch": "master"
      }
    },
    "aliases": {
      "components": "src/lib/components",
      "ui": "src/lib/components/ui",
      "utils": "src/lib/utils.ts",
      "css": "src/app.css",
      "blocks": "src/lib/blocks"
    },
    "lockFile": ".vibelog/installed.lock.json"
  }
}
