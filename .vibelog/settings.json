      "prompt": "researcher",
      "default_status": "Spec"
    },
    "auditor": {
      "label": "Аудитор",
      "description": "Находит несоответствия, создаёт задачи на фикс",
      "prompt": "auditor",
      "allow_tools": [
        "backlog_search",
        "read_file",
        "search_files"
      ],
      "default_status": "Spec"
    }
  },
  "commit_coauthor": true,
  "pricing_guard": {
    "enabled": true,
    "on_drift": "ask",
    "offline": "allow"
  }
