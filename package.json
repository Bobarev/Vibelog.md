{
  "name": "vibelog.md",
  "version": "1.5.0",
  "description": "Markdown-нативный таск-менеджер для git-репозиториев, совместимый с Backlog.md. Чистый Node.js, без нативных зависимостей.",
  "type": "module",
  "bin": {
    "vibelog": "./bin/vibelog.mjs"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test src",
    "lint": "node --check bin/vibelog.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.7.1",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
