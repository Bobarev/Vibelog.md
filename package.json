{
  "name": "vibelog.md",
  "version": "1.6.0",
  "description": "Markdown-нативный таск-менеджер для git-репозиториев, совместимый с Backlog.md. Чистый Node.js, без нативных зависимостей.",
  "type": "module",
  "bin": {
    "vibelog": "./bin/vibelog.mjs",
    "vibelog-agent": "./bin/vibelog-agent.mjs"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "web/dist"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "web:build": "pnpm --dir web build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test src",
    "lint": "node --check bin/vibelog.mjs && node --check bin/vibelog-agent.mjs",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.7.1",
  "license": "Unlicense",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "ink": "7.0.3",
    "react": "^19.2.4",
    "undici": "^6.29.0"
  }
}
