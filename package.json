{
  "name": "vibelog.md",
  "version": "1.9.0",
  "description": "Markdown-нативный таск-менеджер для git-репозиториев, совместимый с Backlog.md. Чистый Node.js, без нативных зависимостей.",
  "type": "module",
  "bin": {
    "vibelog": "./bin/vibelog.mjs",
    "vibelog-agent": "./bin/vibelog-agent.mjs",
    "vb": "./bin/vibelog.mjs"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "web/dist"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "web:build": "pnpm --dir web build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run --exclude src/web/static.test.mjs && vitest run src/web/static.test.mjs",
    "test:fast": "vitest run",
    "lint": "node --check bin/vibelog.mjs && node --check bin/vibelog-agent.mjs",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.7.1",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://gitverse.ru/bobarev/Vibelog.md"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "@types/turndown": "^5.0.6"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "undici": "^6.29.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
